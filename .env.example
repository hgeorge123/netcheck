# Variables used by `make run-local`. Never commit real values.
# development is required (together with environment: development in the
# config file) for local laboratories.
NETCHECK_ENV=development
# Initial admin password (>= 12 chars), only used when no admin exists yet.
NETCHECK_BOOTSTRAP_ADMIN_PASSWORD=
# Optional: kubeconfig of a LABORATORY cluster. Never point it at production.
KUBECONFIG=
